---
---
<section id="diff-tool" class="py-16 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <!-- Section Title -->
  <div class="text-center max-w-3xl mx-auto mb-12">
    <h2 class="font-display text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
      File Diff Tool
    </h2>
    <p class="mt-3 text-base text-zinc-400">
      Drag your files, paste text, or load our example to see differences instantly.
    </p>
  </div>

  <!-- Interactive Dashboard (GitHub Dark themed card) -->
  <div class="rounded-2xl border border-[#30363d] bg-[#0d1117] p-4 sm:p-6 shadow-2xl relative">
    
    <!-- Controls Bar -->
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-[#30363d] pb-6 mb-6">
      
      <!-- Left side: Mode selection and utilities -->
      <div class="flex flex-wrap items-center gap-3">
        <!-- View Toggle Buttons -->
        <div class="inline-flex rounded-xl bg-[#010409] p-1 border border-[#30363d] shadow-inner">
          <button 
            id="btn-view-side" 
            class="flex items-center gap-1.5 rounded-lg px-2 py-1.5 sm:px-4 text-xs sm:text-sm font-semibold transition-all duration-200 bg-[#21262d] text-[#c9d1d9] border border-[#8b949e]/40 shadow-sm"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" />
            </svg>
            Split<span class="hidden sm:inline"> View</span>
          </button>
          <button 
            id="btn-view-unified" 
            class="flex items-center gap-1.5 rounded-lg px-2 py-1.5 sm:px-4 text-xs sm:text-sm font-medium text-[#8b949e] hover:text-[#c9d1d9] transition-all duration-200"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            Unified<span class="hidden sm:inline"> View</span>
          </button>
        </div>

        <!-- Toggle inputs visibility -->
        <button
          id="btn-toggle-inputs"
          class="flex items-center gap-1.5 rounded-xl border border-[#30363d] bg-[#21262d] hover:bg-[#30363d] hover:border-[#8b949e] px-2.5 py-2 sm:px-4 sm:py-2.5 text-xs font-semibold text-[#c9d1d9] transition-all duration-200 shadow-sm"
          title="Hide or show the input editors"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path id="btn-toggle-inputs-icon" stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          <span id="btn-toggle-inputs-text">Hide Inputs</span>
        </button>
      </div>

      <!-- Right side: Actions -->
      <div class="flex items-center gap-3">
        <!-- Load Example -->
        <button 
          id="btn-load-example" 
          class="flex items-center gap-1.5 rounded-xl border border-[#30363d] bg-[#21262d] hover:bg-[#30363d] hover:border-[#8b949e] px-4 py-2.5 text-xs font-semibold text-[#c9d1d9] transition-all duration-200 shadow-sm"
        >
          <svg class="h-4 w-4 text-[#8b949e]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 113.586 0z" />
          </svg>
          Load Example
        </button>

        <!-- Clear inputs -->
        <button 
          id="btn-clear" 
          class="flex items-center gap-1.5 rounded-xl border border-[#f85149]/40 bg-[#f85149]/10 hover:bg-[#f85149]/20 px-4 py-2.5 text-xs font-semibold text-[#ff7b72] transition-all duration-200 shadow-sm"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
          Clear
        </button>
      </div>
    </div>

    <!-- Inputs Panel Wrapper (Smooth Height Transition using Grid template rows, preventing clipping on all viewports) -->
    <div id="inputs-panel-wrapper" class="grid transition-all duration-300 ease-in-out opacity-100 mb-6" style="grid-template-rows: 1fr;">
      <div class="overflow-hidden">
        <div id="inputs-panel" class="grid grid-cols-1 md:grid-cols-2 gap-6 pb-2">
          
          <!-- Input Left (Original) -->
          <div class="flex flex-col">
            <div class="flex items-center justify-between mb-2 gap-2">
              <label class="text-xs font-semibold uppercase tracking-wider text-[#8b949e] truncate flex-shrink-0">Original Text (Left)</label>
              <div class="flex items-center gap-2 min-w-0">
                <span id="file-name-left-container" class="hidden text-2xs font-mono bg-[#010409] border border-[#30363d] text-[#8b949e] px-2 py-0.5 rounded truncate max-w-[110px] sm:max-w-[200px]">
                  Original: <span id="file-name-left" class="truncate"></span>
                </span>
                <button id="btn-copy-left" class="text-2xs text-[#8b949e] hover:text-[#c9d1d9] font-medium transition-colors flex-shrink-0">Copy</button>
              </div>
            </div>
            
            <!-- Drag & Drop Zone Left -->
            <div 
              id="drop-zone-left" 
              class="drag-zone flex flex-col flex-1 relative rounded-xl border border-[#30363d] bg-[#010409] p-1.5 focus-within:border-[#58a6ff]/50 transition-colors"
            >
              <div class="flex flex-col items-center justify-center p-3 text-center border border-[#30363d]/40 rounded-lg bg-[#0d1117] hover:bg-[#161b22] transition-colors cursor-pointer group relative">
                <input type="file" id="file-input-left" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />
                <svg class="h-6 w-6 text-[#8b949e] group-hover:text-[#58a6ff] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                </svg>
                <p class="mt-1 text-2xs font-semibold text-[#8b949e] group-hover:text-[#c9d1d9]">Drag a file here or click to select</p>
              </div>

              <textarea 
                id="text-input-left" 
                placeholder="Paste or type your original text here..."
                class="w-full min-h-[220px] max-h-[400px] flex-1 bg-transparent p-3 text-xs sm:text-sm font-mono text-[#c9d1d9] placeholder-[#484f58] focus:outline-none resize-y mt-2"
              ></textarea>
            </div>
          </div>

          <!-- Input Right (Modified) -->
          <div class="flex flex-col">
            <div class="flex items-center justify-between mb-2 gap-2">
              <label class="text-xs font-semibold uppercase tracking-wider text-[#8b949e] truncate flex-shrink-0">Modified Text (Right)</label>
              <div class="flex items-center gap-2 min-w-0">
                <span id="file-name-right-container" class="hidden text-2xs font-mono bg-[#010409] border border-[#30363d] text-[#8b949e] px-2 py-0.5 rounded truncate max-w-[110px] sm:max-w-[200px]">
                  Modified: <span id="file-name-right" class="truncate"></span>
                </span>
                <button id="btn-copy-right" class="text-2xs text-[#8b949e] hover:text-[#c9d1d9] font-medium transition-colors flex-shrink-0">Copy</button>
              </div>
            </div>

            <!-- Drag & Drop Zone Right -->
            <div 
              id="drop-zone-right" 
              class="drag-zone flex flex-col flex-1 relative rounded-xl border border-[#30363d] bg-[#010409] p-1.5 focus-within:border-[#58a6ff]/50 transition-colors"
            >
              <div class="flex flex-col items-center justify-center p-3 text-center border border-[#30363d]/40 rounded-lg bg-[#0d1117] hover:bg-[#161b22] transition-colors cursor-pointer group relative">
                <input type="file" id="file-input-right" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />
                <svg class="h-6 w-6 text-[#8b949e] group-hover:text-[#58a6ff] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                </svg>
                <p class="mt-1 text-2xs font-semibold text-[#8b949e] group-hover:text-[#c9d1d9]">Drag a file here or click to select</p>
              </div>

              <textarea 
                id="text-input-right" 
                placeholder="Paste or type your modified text here..."
                class="w-full min-h-[220px] max-h-[400px] flex-1 bg-transparent p-3 text-xs sm:text-sm font-mono text-[#c9d1d9] placeholder-[#484f58] focus:outline-none resize-y mt-2"
              ></textarea>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- Output Stats Bar -->
    <div id="stats-panel" class="flex flex-wrap items-center justify-between gap-4 bg-[#161b22] border border-[#30363d] rounded-xl px-4 py-3 mb-4">
      <div class="flex items-center gap-4 text-xs">
        <span class="text-[#8b949e]">Result:</span>
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center gap-1 rounded bg-[rgba(248,81,73,0.15)] px-2 py-0.5 text-xs font-semibold text-[#f85149] border border-[rgba(248,81,73,0.4)]">
            <span id="stats-removed">0</span> deletions
          </span>
          <span class="inline-flex items-center gap-1 rounded bg-[rgba(46,160,67,0.15)] px-2 py-0.5 text-xs font-semibold text-[#3fb950] border border-[rgba(46,160,67,0.4)]">
            <span id="stats-added">0</span> additions
          </span>
          <span id="stats-no-changes" class="hidden text-[#8b949e] italic">Files are identical</span>
        </div>
      </div>

      <!-- Quick Search filter -->
      <div class="relative w-full max-w-xs">
        <input 
          type="text" 
          id="diff-search" 
          placeholder="Search differences..." 
          class="w-full rounded-lg bg-[#010409] border border-[#30363d] px-3 py-1.5 text-xs text-[#c9d1d9] placeholder-[#484f58] focus:outline-none focus:border-[#58a6ff]/70"
        />
        <svg class="absolute right-2.5 top-2.5 h-3.5 w-3.5 text-[#484f58]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
    </div>

    <!-- Rendered Diff Output Section (GitHub Layout style) -->
    <div class="rounded-xl border border-[#30363d] bg-[#0d1117] overflow-hidden">
      <!-- Target Scrollable Container -->
      <div id="diff-render-container" class="overflow-x-auto w-full">
        <!-- File Headers inside output (visible in side-by-side mode) -->
        <div id="diff-output-headers" class="grid grid-cols-2 divide-x divide-[#30363d] border-b border-[#30363d] bg-[#161b22] px-4 py-2.5 font-mono text-2xs text-[#8b949e] select-none min-w-[768px]">
          <div>ORIGINAL FILE</div>
          <div class="pl-4">MODIFIED FILE</div>
        </div>
        <!-- Rendered lines go here -->
        <div id="diff-output-pane" class="min-w-[768px] text-xs font-mono divide-y divide-[#30363d]/30">
          <div class="p-8 text-center text-[#8b949e] italic">
            Enter text in the editors above to see the differences.
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Front-end Client Bundled Script -->
<script>
  import * as Diff from 'diff';

  // Constants & Sample Data
  const SAMPLE_LEFT = `// Original server configuration
const serverConfig = {
  port: 8080,
  host: "localhost",
  environment: "development",
  database: {
    client: "sqlite3",
    connection: {
      filename: "./dev.sqlite3"
    },
    useNullAsDefault: true
  },
  cors: {
    origin: "*",
    methods: ["GET", "POST"]
  },
  features: {
    websockets: false,
    analytics: false,
    debugMode: true
  },
  maxConnections: 100,
  timeout: 5000
};

console.log("Server started on port: " + serverConfig.port);`;

  const SAMPLE_RIGHT = `// Updated server configuration (Production)
const serverConfig = {
  port: 443,
  host: "api.mydomain.com",
  environment: "production",
  database: {
    client: "pg",
    connection: process.env.DATABASE_URL,
    pool: { min: 2, max: 10 }
  },
  cors: {
    origin: ["https://mydomain.com", "https://admin.mydomain.com"],
    methods: ["GET", "POST", "PUT", "DELETE"],
    credentials: true
  },
  features: {
    websockets: true,
    analytics: true,
    debugMode: false
  },
  maxConnections: 1000,
  timeout: 3000,
  ssl: {
    cert: "/etc/ssl/certs/server.crt",
    key: "/etc/ssl/private/server.key"
  }
};

console.log(\`Server for \${serverConfig.environment} running on port \${serverConfig.port}\`);`;

  // DOM Elements
  const btnViewSide = document.getElementById('btn-view-side') as HTMLButtonElement;
  const btnViewUnified = document.getElementById('btn-view-unified') as HTMLButtonElement;
  const btnToggleInputs = document.getElementById('btn-toggle-inputs') as HTMLButtonElement;
  const btnToggleInputsIcon = document.getElementById('btn-toggle-inputs-icon') as SVGPathElement;
  const btnToggleInputsText = document.getElementById('btn-toggle-inputs-text') as HTMLSpanElement;
  const inputsPanelWrapper = document.getElementById('inputs-panel-wrapper') as HTMLDivElement;

  const btnLoadExample = document.getElementById('btn-load-example') as HTMLButtonElement;
  const btnClear = document.getElementById('btn-clear') as HTMLButtonElement;

  const textInputLeft = document.getElementById('text-input-left') as HTMLTextAreaElement;
  const textInputRight = document.getElementById('text-input-right') as HTMLTextAreaElement;

  const fileInputLeft = document.getElementById('file-input-left') as HTMLInputElement;
  const fileInputRight = document.getElementById('file-input-right') as HTMLInputElement;
  const fileNameLeftContainer = document.getElementById('file-name-left-container') as HTMLSpanElement;
  const fileNameRightContainer = document.getElementById('file-name-right-container') as HTMLSpanElement;
  const fileNameLeft = document.getElementById('file-name-left') as HTMLSpanElement;
  const fileNameRight = document.getElementById('file-name-right') as HTMLSpanElement;

  const btnCopyLeft = document.getElementById('btn-copy-left') as HTMLButtonElement;
  const btnCopyRight = document.getElementById('btn-copy-right') as HTMLButtonElement;

  const statsRemoved = document.getElementById('stats-removed') as HTMLSpanElement;
  const statsAdded = document.getElementById('stats-added') as HTMLSpanElement;
  const statsNoChanges = document.getElementById('stats-no-changes') as HTMLSpanElement;
  const diffSearch = document.getElementById('diff-search') as HTMLInputElement;

  const diffOutputHeaders = document.getElementById('diff-output-headers') as HTMLDivElement;
  const diffRenderContainer = document.getElementById('diff-render-container') as HTMLDivElement;
  const diffOutputPane = document.getElementById('diff-output-pane') as HTMLDivElement;

  const dropZoneLeft = document.getElementById('drop-zone-left') as HTMLDivElement;
  const dropZoneRight = document.getElementById('drop-zone-right') as HTMLDivElement;

  // App State
  let currentViewMode: 'side' | 'unified' = 'side';
  let areInputsCollapsed = false;
  let searchTerm = '';

  // Helpers
  function escapeHTML(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function getWordDiffHTML(leftLine: string, rightLine: string): { leftHTML: string; rightHTML: string } {
    const diffs = Diff.diffWords(leftLine, rightLine);
    
    let addedLen = 0;
    let removedLen = 0;
    let commonLen = 0;
    for (const part of diffs) {
      if (part.added) addedLen += part.value.length;
      else if (part.removed) removedLen += part.value.length;
      else commonLen += part.value.length;
    }
    
    const totalLen = Math.max(leftLine.length, rightLine.length);
    const similarity = totalLen > 0 ? (commonLen / totalLen) : 1;
    
    // If similarity is low, skip character highlighting to avoid messy results
    if (similarity < 0.35) {
      return {
        leftHTML: escapeHTML(leftLine),
        rightHTML: escapeHTML(rightLine)
      };
    }
    
    let leftHTML = '';
    let rightHTML = '';
    
    for (const part of diffs) {
      const escaped = escapeHTML(part.value);
      if (part.removed) {
        leftHTML += `<span class="bg-[rgba(248,81,73,0.4)] text-[#ff9e9a] rounded px-0.5 font-semibold">${escaped}</span>`;
      } else if (part.added) {
        rightHTML += `<span class="bg-[rgba(46,160,67,0.4)] text-[#acf2bd] rounded px-0.5 font-semibold">${escaped}</span>`;
      } else {
        leftHTML += escaped;
        rightHTML += escaped;
      }
    }
    
    return { leftHTML, rightHTML };
  }

  function debounce(func: Function, wait: number) {
    let timeout: number;
    return function executedFunction(...args: any[]) {
      const later = () => {
        clearTimeout(timeout);
        func(...args);
      };
      clearTimeout(timeout);
      timeout = setTimeout(later, wait) as unknown as number;
    };
  }

  // File Upload Handlers
  function handleFileUpload(file: File, side: 'left' | 'right') {
    const reader = new FileReader();
    reader.onload = (e) => {
      const text = e.target?.result as string;
      if (side === 'left') {
        textInputLeft.value = text;
        fileNameLeft.innerText = file.name;
        fileNameLeftContainer.classList.remove('hidden');
      } else {
        textInputRight.value = text;
        fileNameRight.innerText = file.name;
        fileNameRightContainer.classList.remove('hidden');
      }
      runDiff();
    };
    reader.readAsText(file);
  }

  // Setup Drag and Drop events
  [
    { zone: dropZoneLeft, input: fileInputLeft, side: 'left' as const },
    { zone: dropZoneRight, input: fileInputRight, side: 'right' as const }
  ].forEach(({ zone, input, side }) => {
    // Click triggers file selector
    input.addEventListener('change', (e) => {
      const file = input.files?.[0];
      if (file) handleFileUpload(file, side);
    });

    // Drag-over styling
    zone.addEventListener('dragover', (e) => {
      e.preventDefault();
      zone.classList.add('border-[#58a6ff]', 'bg-indigo-500/5');
    });

    zone.addEventListener('dragleave', () => {
      zone.classList.remove('border-[#58a6ff]', 'bg-indigo-500/5');
    });

    zone.addEventListener('drop', (e) => {
      e.preventDefault();
      zone.classList.remove('border-[#58a6ff]', 'bg-indigo-500/5');
      const file = e.dataTransfer?.files?.[0];
      if (file) handleFileUpload(file, side);
    });
  });

  // Main Diff Engine & UI Renderer
  function runDiff() {
    const leftText = textInputLeft.value;
    const rightText = textInputRight.value;

    if (!leftText && !rightText) {
      diffOutputPane.innerHTML = `
        <div class="p-8 text-center text-[#8b949e] italic">
          Introduce textos en los editores de arriba para ver las diferencias.
        </div>
      `;
      statsRemoved.innerText = '0';
      statsAdded.innerText = '0';
      statsNoChanges.classList.add('hidden');
      return;
    }

    // Call JS-Diff
    const diffParts = Diff.diffLines(leftText, rightText);

    // Compute stats
    let totalRemoved = 0;
    let totalAdded = 0;
    diffParts.forEach(part => {
      const lines = part.value.split('\n');
      if (lines.length > 0 && lines[lines.length - 1] === '') lines.pop();
      
      if (part.removed) totalRemoved += lines.length;
      else if (part.added) totalAdded += lines.length;
    });

    statsRemoved.innerText = totalRemoved.toString();
    statsAdded.innerText = totalAdded.toString();

    if (totalRemoved === 0 && totalAdded === 0 && (leftText || rightText)) {
      statsNoChanges.classList.remove('hidden');
    } else {
      statsNoChanges.classList.add('hidden');
    }

    // Render based on mode
    if (currentViewMode === 'side') {
      diffOutputHeaders.classList.remove('hidden');
      diffOutputPane.classList.add('min-w-[768px]');
      diffOutputPane.classList.remove('w-full');
      renderSideBySide(diffParts);
    } else {
      diffOutputHeaders.classList.add('hidden');
      diffOutputPane.classList.remove('min-w-[768px]');
      diffOutputPane.classList.add('w-full');
      renderUnified(diffParts);
    }
  }

  function renderSideBySide(diffs: Diff.Change[]) {
    let leftLineNum = 1;
    let rightLineNum = 1;
    let html = '';

    for (let i = 0; i < diffs.length; i++) {
      const current = diffs[i];
      const next = diffs[i + 1];

      const currentLines = current.value.split('\n');
      if (currentLines.length > 0 && currentLines[currentLines.length - 1] === '') currentLines.pop();

      // Case 1: Removed block followed by Added block (Modification)
      if (current.removed && next && next.added) {
        const nextLines = next.value.split('\n');
        if (nextLines.length > 0 && nextLines[nextLines.length - 1] === '') nextLines.pop();

        const maxLines = Math.max(currentLines.length, nextLines.length);

        for (let k = 0; k < maxLines; k++) {
          const hasLeft = k < currentLines.length;
          const hasRight = k < nextLines.length;

          const lVal = hasLeft ? currentLines[k] : '';
          const rVal = hasRight ? nextLines[k] : '';

          let leftHTML = escapeHTML(lVal);
          let rightHTML = escapeHTML(rVal);

          if (hasLeft && hasRight) {
            const innerDiff = getWordDiffHTML(lVal, rVal);
            leftHTML = innerDiff.leftHTML;
            rightHTML = innerDiff.rightHTML;
          }

          // Search filtering
          if (searchTerm) {
            const matchLeft = lVal.toLowerCase().includes(searchTerm);
            const matchRight = rVal.toLowerCase().includes(searchTerm);
            if (!matchLeft && !matchRight) continue; // skip row
          }

          const leftBg = hasLeft ? 'bg-[#ffebe9]/10 text-[#ff7b72]' : 'bg-[#161b22]/20 opacity-30';
          const rightBg = hasRight ? 'bg-[#e6ffec]/10 text-[#7ee787]' : 'bg-[#161b22]/20 opacity-30';
          
          const leftGutterBg = hasLeft ? 'bg-[#ffebe9]/15 text-[#ff7b72]' : '';
          const rightGutterBg = hasRight ? 'bg-[#e6ffec]/15 text-[#7ee787]' : '';

          const leftSignColor = hasLeft ? 'text-[#ff7b72] font-semibold' : 'text-[#8b949e]/10';
          const rightSignColor = hasRight ? 'text-[#7ee787] font-semibold' : 'text-[#8b949e]/10';

          html += `
            <div class="flex w-full divide-x divide-[#30363d] hover:bg-[#161b22]/10">
              <!-- Left Cell -->
              <div class="flex-1 flex min-w-0 py-0.5 pr-2 ${leftBg}">
                <span class="w-10 select-none text-right pr-3 text-[#8b949e] font-mono flex-shrink-0 ${leftGutterBg}">${hasLeft ? leftLineNum++ : ''}</span>
                <span class="w-4 select-none text-center font-mono flex-shrink-0 ${leftSignColor}">${hasLeft ? '-' : ''}</span>
                <pre class="flex-1 overflow-x-auto whitespace-pre font-mono scrollbar-none text-[#c9d1d9]">${leftHTML}</pre>
              </div>
              <!-- Right Cell -->
              <div class="flex-1 flex min-w-0 py-0.5 pr-2 ${rightBg}">
                <span class="w-10 select-none text-right pr-3 pl-4 text-[#8b949e] font-mono flex-shrink-0 ${rightGutterBg}">${hasRight ? rightLineNum++ : ''}</span>
                <span class="w-4 select-none text-center font-mono flex-shrink-0 ${rightSignColor}">${hasRight ? '+' : ''}</span>
                <pre class="flex-1 overflow-x-auto whitespace-pre font-mono scrollbar-none text-[#c9d1d9]">${rightHTML}</pre>
              </div>
            </div>
          `;
        }
        i++; // skip next since we handled it
      }
      // Case 2: Just Removed lines
      else if (current.removed) {
        for (const line of currentLines) {
          if (searchTerm && !line.toLowerCase().includes(searchTerm)) continue;

          html += `
            <div class="flex w-full divide-x divide-[#30363d] hover:bg-[#161b22]/10">
              <div class="flex-1 flex min-w-0 py-0.5 pr-2 bg-[#ffebe9]/10 text-[#ff7b72]">
                <span class="w-10 select-none text-right pr-3 text-[#ff7b72] bg-[#ffebe9]/15 font-mono flex-shrink-0">${leftLineNum++}</span>
                <span class="w-4 select-none text-center text-[#ff7b72] font-semibold font-mono flex-shrink-0">-</span>
                <pre class="flex-1 overflow-x-auto whitespace-pre font-mono scrollbar-none text-[#c9d1d9]">${escapeHTML(line)}</pre>
              </div>
              <div class="flex-1 flex min-w-0 py-0.5 pr-2 bg-[#161b22]/20 opacity-30">
                <span class="w-10 select-none text-right pr-3 pl-4 text-[#8b949e] font-mono flex-shrink-0"></span>
                <span class="w-4 select-none text-center text-[#8b949e]/10 font-mono flex-shrink-0"></span>
                <pre class="flex-1 overflow-x-auto whitespace-pre font-mono scrollbar-none text-[#c9d1d9]"></pre>
              </div>
            </div>
          `;
        }
      }
      // Case 3: Just Added lines
      else if (current.added) {
        for (const line of currentLines) {
          if (searchTerm && !line.toLowerCase().includes(searchTerm)) continue;

          html += `
            <div class="flex w-full divide-x divide-[#30363d] hover:bg-[#161b22]/10">
              <div class="flex-1 flex min-w-0 py-0.5 pr-2 bg-[#161b22]/20 opacity-30">
                <span class="w-10 select-none text-right pr-3 text-[#8b949e] font-mono flex-shrink-0"></span>
                <span class="w-4 select-none text-center text-[#8b949e]/10 font-mono flex-shrink-0"></span>
                <pre class="flex-1 overflow-x-auto whitespace-pre font-mono scrollbar-none text-[#c9d1d9]"></pre>
              </div>
              <div class="flex-1 flex min-w-0 py-0.5 pr-2 bg-[#e6ffec]/10 text-[#7ee787]">
                <span class="w-10 select-none text-right pr-3 pl-4 text-[#7ee787] bg-[#e6ffec]/15 font-mono flex-shrink-0">${rightLineNum++}</span>
                <span class="w-4 select-none text-center text-[#7ee787] font-semibold font-mono flex-shrink-0">+</span>
                <pre class="flex-1 overflow-x-auto whitespace-pre font-mono scrollbar-none text-[#c9d1d9]">${escapeHTML(line)}</pre>
              </div>
            </div>
          `;
        }
      }
      // Case 4: Unchanged lines
      else {
        for (const line of currentLines) {
          if (searchTerm && !line.toLowerCase().includes(searchTerm)) continue;

          html += `
            <div class="flex w-full divide-x divide-[#30363d] hover:bg-[#161b22]/10">
              <div class="flex-1 flex min-w-0 py-0.5 pr-2 text-[#8b949e]">
                <span class="w-10 select-none text-right pr-3 text-[#8b949e] font-mono flex-shrink-0">${leftLineNum++}</span>
                <span class="w-4 select-none text-center text-[#8b949e]/20 font-mono flex-shrink-0"></span>
                <pre class="flex-1 overflow-x-auto whitespace-pre font-mono scrollbar-none text-[#c9d1d9]">${escapeHTML(line)}</pre>
              </div>
              <div class="flex-1 flex min-w-0 py-0.5 pr-2 text-[#8b949e]">
                <span class="w-10 select-none text-right pr-3 pl-4 text-[#8b949e] font-mono flex-shrink-0">${rightLineNum++}</span>
                <span class="w-4 select-none text-center text-[#8b949e]/20 font-mono flex-shrink-0"></span>
                <pre class="flex-1 overflow-x-auto whitespace-pre font-mono scrollbar-none text-[#c9d1d9]">${escapeHTML(line)}</pre>
              </div>
            </div>
          `;
        }
      }
    }

    if (!html) {
      diffOutputPane.innerHTML = `<div class="p-8 text-center text-[#8b949e] italic">No se encontraron líneas que coincidan con la búsqueda.</div>`;
    } else {
      diffOutputPane.innerHTML = html;
    }
  }

  function renderUnified(diffs: Diff.Change[]) {
    let leftLineNum = 1;
    let rightLineNum = 1;
    let html = '';

    for (let i = 0; i < diffs.length; i++) {
      const current = diffs[i];
      const next = diffs[i + 1];

      const currentLines = current.value.split('\n');
      if (currentLines.length > 0 && currentLines[currentLines.length - 1] === '') currentLines.pop();

      // Case 1: Removed followed by Added (Modification inline)
      if (current.removed && next && next.added) {
        const nextLines = next.value.split('\n');
        if (nextLines.length > 0 && nextLines[nextLines.length - 1] === '') nextLines.pop();

        // Print removed lines first, highlighting differences against corresponding added lines
        for (let k = 0; k < currentLines.length; k++) {
          const line = currentLines[k];
          if (searchTerm && !line.toLowerCase().includes(searchTerm)) continue;

          let lineHTML = escapeHTML(line);
          if (k < nextLines.length) {
            const innerDiff = getWordDiffHTML(line, nextLines[k]);
            lineHTML = innerDiff.leftHTML;
          }

          html += `
            <div class="flex w-full py-0.5 pr-2 bg-[#ffebe9]/10 text-[#ff7b72] border-l-2 border-[#ff7b72]/50 hover:bg-[#ffebe9]/15">
              <span class="w-10 select-none text-right pr-3 text-[#ff7b72] bg-[#ffebe9]/15 font-mono flex-shrink-0">${leftLineNum++}</span>
              <span class="w-10 select-none text-right pr-3 text-[#8b949e]/10 font-mono flex-shrink-0"></span>
              <span class="w-4 select-none text-center text-[#ff7b72] font-semibold font-mono flex-shrink-0">-</span>
              <pre class="flex-1 overflow-x-auto whitespace-pre font-mono scrollbar-none text-[#c9d1d9]">${lineHTML}</pre>
            </div>
          `;
        }

        // Print added lines next, highlighting differences
        for (let k = 0; k < nextLines.length; k++) {
          const line = nextLines[k];
          if (searchTerm && !line.toLowerCase().includes(searchTerm)) continue;

          let lineHTML = escapeHTML(line);
          if (k < currentLines.length) {
            const innerDiff = getWordDiffHTML(currentLines[k], line);
            lineHTML = innerDiff.rightHTML;
          }

          html += `
            <div class="flex w-full py-0.5 pr-2 bg-[#e6ffec]/10 text-[#7ee787] border-l-2 border-[#7ee787]/50 hover:bg-[#e6ffec]/15">
              <span class="w-10 select-none text-right pr-3 text-[#8b949e]/10 font-mono flex-shrink-0"></span>
              <span class="w-10 select-none text-right pr-3 text-[#7ee787] bg-[#e6ffec]/15 font-mono flex-shrink-0">${rightLineNum++}</span>
              <span class="w-4 select-none text-center text-[#7ee787] font-semibold font-mono flex-shrink-0">+</span>
              <pre class="flex-1 overflow-x-auto whitespace-pre font-mono scrollbar-none text-[#c9d1d9]">${lineHTML}</pre>
            </div>
          `;
        }
        i++; // skip added part
      }
      // Case 2: Just Removed
      else if (current.removed) {
        for (const line of currentLines) {
          if (searchTerm && !line.toLowerCase().includes(searchTerm)) continue;

          html += `
            <div class="flex w-full py-0.5 pr-2 bg-[#ffebe9]/10 text-[#ff7b72] border-l-2 border-[#ff7b72]/50 hover:bg-[#ffebe9]/15">
              <span class="w-10 select-none text-right pr-3 text-[#ff7b72] bg-[#ffebe9]/15 font-mono flex-shrink-0">${leftLineNum++}</span>
              <span class="w-10 select-none text-right pr-3 text-[#8b949e]/10 font-mono flex-shrink-0"></span>
              <span class="w-4 select-none text-center text-[#ff7b72] font-semibold font-mono flex-shrink-0">-</span>
              <pre class="flex-1 overflow-x-auto whitespace-pre font-mono scrollbar-none text-[#c9d1d9]">${escapeHTML(line)}</pre>
            </div>
          `;
        }
      }
      // Case 3: Just Added
      else if (current.added) {
        for (const line of currentLines) {
          if (searchTerm && !line.toLowerCase().includes(searchTerm)) continue;

          html += `
            <div class="flex w-full py-0.5 pr-2 bg-[#e6ffec]/10 text-[#7ee787] border-l-2 border-[#7ee787]/50 hover:bg-[#e6ffec]/15">
              <span class="w-10 select-none text-right pr-3 text-[#8b949e]/10 font-mono flex-shrink-0"></span>
              <span class="w-10 select-none text-right pr-3 text-[#7ee787] bg-[#e6ffec]/15 font-mono flex-shrink-0">${rightLineNum++}</span>
              <span class="w-4 select-none text-center text-[#7ee787] font-semibold font-mono flex-shrink-0">+</span>
              <pre class="flex-1 overflow-x-auto whitespace-pre font-mono scrollbar-none text-[#c9d1d9]">${escapeHTML(line)}</pre>
            </div>
          `;
        }
      }
      // Case 4: Unchanged
      else {
        for (const line of currentLines) {
          if (searchTerm && !line.toLowerCase().includes(searchTerm)) continue;

          html += `
            <div class="flex w-full py-0.5 pr-2 text-[#8b949e] hover:bg-[#161b22]/10">
              <span class="w-10 select-none text-right pr-3 text-[#8b949e] font-mono flex-shrink-0">${leftLineNum++}</span>
              <span class="w-10 select-none text-right pr-3 text-[#8b949e] font-mono flex-shrink-0">${rightLineNum++}</span>
              <span class="w-4 select-none text-center text-[#8b949e]/20 font-mono flex-shrink-0"></span>
              <pre class="flex-1 overflow-x-auto whitespace-pre font-mono scrollbar-none text-[#c9d1d9]">${escapeHTML(line)}</pre>
            </div>
          `;
        }
      }
    }

    if (!html) {
      diffOutputPane.innerHTML = `<div class="p-8 text-center text-[#8b949e] italic">No matching lines found.</div>`;
    } else {
      diffOutputPane.innerHTML = html;
    }
  }

  // Event Listeners for UI
  const debouncedDiff = debounce(runDiff, 150);

  textInputLeft.addEventListener('input', debouncedDiff);
  textInputRight.addEventListener('input', debouncedDiff);

  diffSearch.addEventListener('input', (e) => {
    searchTerm = (e.target as HTMLInputElement).value.toLowerCase();
    runDiff();
  });

  // Helper to update button states (GitHub Dark style toggles)
  function setButtonState(activeBtn: HTMLButtonElement, inactiveBtn: HTMLButtonElement) {
    activeBtn.className = "flex items-center gap-1.5 rounded-lg px-2 py-1.5 sm:px-4 text-xs sm:text-sm font-semibold transition-all duration-200 bg-[#21262d] text-[#c9d1d9] border border-[#8b949e]/40 shadow-sm";
    inactiveBtn.className = "flex items-center gap-1.5 rounded-lg px-2 py-1.5 sm:px-4 text-xs sm:text-sm font-medium text-[#8b949e] hover:text-[#c9d1d9] bg-transparent border-0 transition-all duration-200";
  }

  // Switch to Side-by-Side View
  btnViewSide.addEventListener('click', () => {
    currentViewMode = 'side';
    setButtonState(btnViewSide, btnViewUnified);
    runDiff();
  });

  // Switch to Unified View
  btnViewUnified.addEventListener('click', () => {
    currentViewMode = 'unified';
    setButtonState(btnViewUnified, btnViewSide);
    runDiff();
  });

  // Toggle Input panel visibility using height grid rows (never clips on small viewports)
  btnToggleInputs.addEventListener('click', () => {
    areInputsCollapsed = !areInputsCollapsed;
    if (areInputsCollapsed) {
      inputsPanelWrapper.style.gridTemplateRows = '0fr';
      inputsPanelWrapper.style.opacity = '0';
      inputsPanelWrapper.style.marginBottom = '0px';
      btnToggleInputsText.innerText = 'Show Inputs';
      btnToggleInputsIcon.setAttribute('d', 'M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858-.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M3 3l18 18');
    } else {
      inputsPanelWrapper.style.gridTemplateRows = '1fr';
      inputsPanelWrapper.style.opacity = '1';
      inputsPanelWrapper.style.marginBottom = '24px';
      btnToggleInputsText.innerText = 'Hide Inputs';
      btnToggleInputsIcon.setAttribute('d', 'M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z');
    }
  });

  // Copy Buttons
  btnCopyLeft.addEventListener('click', () => {
    navigator.clipboard.writeText(textInputLeft.value);
    btnCopyLeft.innerText = 'Copied!';
    setTimeout(() => { btnCopyLeft.innerText = 'Copy'; }, 2000);
  });

  btnCopyRight.addEventListener('click', () => {
    navigator.clipboard.writeText(textInputRight.value);
    btnCopyRight.innerText = 'Copied!';
    setTimeout(() => { btnCopyRight.innerText = 'Copy'; }, 2000);
  });

  // Clear inputs
  btnClear.addEventListener('click', () => {
    textInputLeft.value = '';
    textInputRight.value = '';
    
    fileInputLeft.value = '';
    fileInputRight.value = '';
    fileNameLeftContainer.classList.add('hidden');
    fileNameRightContainer.classList.add('hidden');

    diffSearch.value = '';
    searchTerm = '';

    runDiff();
    textInputLeft.focus();
  });

  // Load Example
  btnLoadExample.addEventListener('click', () => {
    textInputLeft.value = SAMPLE_LEFT;
    textInputRight.value = SAMPLE_RIGHT;

    fileNameLeft.innerText = 'config_original.js';
    fileNameLeftContainer.classList.remove('hidden');
    
    fileNameRight.innerText = 'config_production.js';
    fileNameRightContainer.classList.remove('hidden');

    runDiff();
  });

  // Auto Load example on first page load
  if (document.readyState === 'loading') {
    window.addEventListener('DOMContentLoaded', () => {
      btnLoadExample.click();
    });
  } else {
    btnLoadExample.click();
  }

  // Sync scroll implementation for the diff panels in side-by-side mode
  // The panes are rendered inside tables/flexes inside a single horizontal scroll panel, which handles sync scroll natively.
  // Wait, let's keep vertical scrolls synced! Since side-by-side is inside a single element 'diff-render-container' horizontally,
  // vertical scrolling is handled by the page scroll itself! That is extremely clean and avoids complex scroll syncing completely!
  // But wait, what if the user scrolls horizontally? The outer container scrolls horizontally natively, which keeps columns perfectly aligned.
</script>
