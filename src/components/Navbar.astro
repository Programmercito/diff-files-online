---
---
<header class="sticky top-0 z-50 w-full border-b border-zinc-800/80 bg-zinc-950/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand Logo -->
    <a href="#" class="flex items-center gap-2.5 group transition-transform duration-200 hover:scale-[1.02]">
      <div class="relative flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-tr from-violet-600 via-indigo-600 to-fuchsia-500 shadow-lg shadow-indigo-500/20">
        <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
        </svg>
        <div class="absolute inset-0 rounded-xl bg-white/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      </div>
      <span class="font-display text-xl font-bold tracking-tight text-white">
        Diff<span class="bg-gradient-to-r from-indigo-400 to-fuchsia-400 bg-clip-text text-transparent">Files</span>
      </span>
    </a>

    <!-- Nav Links (Desktop) -->
    <nav class="hidden md:flex items-center gap-8">
      <a href="#inicio" class="text-sm font-medium text-zinc-400 hover:text-white transition-colors duration-200">Inicio</a>
      <a href="#caracteristicas" class="text-sm font-medium text-zinc-400 hover:text-white transition-colors duration-200">Características</a>
      <a href="#privacidad" class="text-sm font-medium text-zinc-400 hover:text-white transition-colors duration-200">Seguridad y Privacidad</a>
    </nav>

    <!-- CTA Buttons -->
    <div class="flex items-center gap-4">
      <a 
        href="#diff-tool" 
        class="relative inline-flex items-center justify-center overflow-hidden rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 p-0.5 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:shadow-indigo-500/20 hover:scale-[1.03] active:scale-[0.98] group"
      >
        <span class="relative rounded-[10px] bg-zinc-950 px-4 py-2 transition-all duration-300 ease-out group-hover:bg-opacity-0">
          Comparar Ahora
        </span>
      </a>
    </div>
  </div>
</header>
