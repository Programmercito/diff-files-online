---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import DiffApp from '../components/DiffApp.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Diff Files Online - Compare Code and Text 100% Free & Secure">
  <Navbar />
  
  <main class="relative z-10">
    <!-- Ambient glowing backgrounds on page-level -->
    <div class="absolute top-[800px] left-1/2 -translate-x-1/2 -z-10 h-[500px] w-[500px] rounded-full bg-indigo-500/5 blur-[120px] pointer-events-none"></div>
    <div class="absolute top-[1600px] right-10 -z-10 h-[400px] w-[400px] rounded-full bg-fuchsia-500/5 blur-[120px] pointer-events-none"></div>

    <Hero />
    <DiffApp />
    <Features />
  </main>

  <Footer />
</Layout>
