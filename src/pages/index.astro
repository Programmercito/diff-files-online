---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import DiffApp from '../components/DiffApp.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Diff Files Online - Compare Code and Text 100% Free & Secure"
  description="Compare two files or texts side-by-side locally, quickly and 100% privately. Find differences in code, JSON, or text without uploading data to any server."
>
  <Navbar />
  
  <main class="relative z-10">
    <Hero />
    <DiffApp />
    <Features />
  </main>

  <Footer />
</Layout>
